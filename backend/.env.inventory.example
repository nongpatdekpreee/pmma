# ตัวอย่าง env สำหรับ deploy บน server inventory (Docker network เดียวกับ tccstock_mysql)
# คัดลอกเป็น .env บน server หรือส่งผ่าน docker run --env-file

DB_HOST=tccstock_mysql
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db

# บังคับ — ว่างจะ login ไม่ได้ (secretOrPrivateKey must have a value)
# สร้างค่า: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-use-openssl-rand-hex-64

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=1
REFRESH_TOKEN_COOKIE_NAME=refreshToken
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

CRON_TIMEZONE=Asia/Bangkok
SNS_UPCOMING_CRON_ENABLED=true
CONTRACT_EXPIRING_CRON_ENABLED=true
