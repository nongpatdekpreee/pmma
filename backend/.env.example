# Database (see config/database.js)
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db


# Microsoft Teams — แจ้งเตือนเมื่อสร้าง/แก้ไขสัญญา หรือสร้าง PM/MA plan
TEAMS_WEBHOOK_PROJECT_OWEN_SNS=

# Microsoft Teams — สรุป PM/MA plan ที่ใกล้ถึง (cron จันทร์ 09:00)
TEAMS_WEBHOOK_SNS_UPCOMING_PLANS=

# Microsoft Teams — สัญญาใกล้หมดอายุ (cron ทุกวัน 09:00) — ว่าง = ใช้ TEAMS_WEBHOOK_PROJECT_OWEN_SNS
TEAMS_WEBHOOK_CONTRACT_EXPIRING=

# แจ้งสัญญาใกล้หมด: cron ทุกวัน 09:00 + ทันทีเมื่อแก้สัญญา (ถ้าอยู่ในช่วงวันนี้ถึง +N วัน)
CONTRACT_EXPIRING_DAYS=30

# Cron: timezone และเปิด/ปิด (false = ปิด)
CRON_TIMEZONE=Asia/Bangkok
SNS_UPCOMING_CRON_ENABLED=true
CONTRACT_EXPIRING_CRON_ENABLED=true
