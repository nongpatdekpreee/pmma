# Database (see config/database.js)
DB_HOST=192.168.60.65
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db


# Microsoft Teams — แจ้งเตือนเมื่อสร้าง PM/MA plan ของ Project_Owen = SNS
TEAMS_WEBHOOK_PROJECT_OWEN_SNS=

# Microsoft Teams — สรุป plan SNS ที่ใกล้ถึง (cron 15:40 ทุกวัน)
TEAMS_WEBHOOK_SNS_UPCOMING_PLANS=

# Cron: timezone และเปิด/ปิด (false = ปิด)
CRON_TIMEZONE=Asia/Bangkok
SNS_UPCOMING_CRON_ENABLED=true
